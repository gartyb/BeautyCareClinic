# Leave unset (or "/api/v1") so the frontend calls a relative, same-origin API path.
# Vite's own dev-server proxy (see vite.config.ts) forwards /api to the backend.
# An absolute URL here (e.g. http://localhost:5000/api/v1) breaks same-origin/CORS-free
# access once the backend port is not directly reachable (Phase 013) and is wrong for any
# remote user anyway, since "localhost" would resolve to *their* machine.
VITE_API_URL=/api/v1
VITE_LOG_API_CALLS=false
